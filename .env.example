# Public application configuration
NEXT_PUBLIC_APP_NAME=OpenCreative
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/Prantikc22/opencreative
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the workspace that receives tickets from the public Nori widget.
# If omitted, the oldest workspace is treated as the platform support workspace.
OPENCREATIVE_SUPPORT_WORKSPACE_ID=

# OpenRouter — never prefix these with NEXT_PUBLIC_
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=OpenCreative

# Cloudflare R2 — bucket should be private
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=opencreative-media
CLOUDFLARE_R2_PUBLIC_OR_CUSTOM_DOMAIN=

# Hosted/BYOK mode
OPENCREATIVE_MODE=self-hosted
GENERATION_WEBHOOK_SECRET=
CRON_SECRET=
