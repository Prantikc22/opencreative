# Public application configuration
NEXT_PUBLIC_APP_NAME=OpenCreative
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/Prantikc22/opencreative
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the workspace that receives tickets from the public Nori widget.
# If omitted, the oldest workspace is treated as the platform support workspace.
OPENCREATIVE_SUPPORT_WORKSPACE_ID=

# OpenRouter — never prefix these with NEXT_PUBLIC_
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=OpenCreative

# Cloudflare R2 — bucket should be private
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=opencreative-media
CLOUDFLARE_R2_PUBLIC_OR_CUSTOM_DOMAIN=

# Hosted/BYOK mode
OPENCREATIVE_MODE=self-hosted
GENERATION_WEBHOOK_SECRET=
CRON_SECRET=

# Paddle Billing (sandbox while developing)
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_PRICE_CREATIVE_STARTER_MONTHLY=
PADDLE_PRICE_CREATIVE_STARTER_ANNUAL=
PADDLE_PRICE_CREATIVE_CREATOR_MONTHLY=
PADDLE_PRICE_CREATIVE_CREATOR_ANNUAL=
PADDLE_PRICE_CREATIVE_PRO_MONTHLY=
PADDLE_PRICE_CREATIVE_PRO_ANNUAL=
PADDLE_PRICE_CREATIVE_STUDIO_MONTHLY=
PADDLE_PRICE_CREATIVE_STUDIO_ANNUAL=
PADDLE_PRICE_AGENT_LAUNCH_MONTHLY=
PADDLE_PRICE_AGENT_LAUNCH_ANNUAL=
PADDLE_PRICE_AGENT_GROWTH_MONTHLY=
PADDLE_PRICE_AGENT_GROWTH_ANNUAL=
PADDLE_PRICE_AGENT_SCALE_MONTHLY=
PADDLE_PRICE_AGENT_SCALE_ANNUAL=
PADDLE_PRICE_CREDITS_250=
PADDLE_PRICE_CREDITS_500=
PADDLE_PRICE_CREDITS_1000=

# Transactional email — server only
RESEND_API_KEY=
RESEND_FROM_EMAIL=OpenCreative <onboarding@resend.dev>
SUPPORT_REPLY_TO_EMAIL=
